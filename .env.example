# SQLite by default (Phase 0). Swap to Postgres when ready:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/bluechipwager
DATABASE_URL=sqlite:///./data/bluechipwager.db

# CFBD — key now, one ping later, no CFB ingest until NFL gates pass
# CFBD_API_KEY=

# Live odds — unused until Phase 22 (nflverse closes are Market 0)
# ODDS_API_KEY=

# Local auth (dev/demo — replace with Cognito in AWS Sprint F)
# Never commit real production passwords.
AUTH_SECRET_KEY=change-me-to-a-long-random-string
AUTH_FREE_USERNAME=demo_free
AUTH_FREE_PASSWORD=demoFree123
AUTH_PRO_USERNAME=demo_pro
AUTH_PRO_PASSWORD=demoPro123
AUTH_RESEARCH_USERNAME=demo_research
AUTH_RESEARCH_PASSWORD=demoResearch123
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=admin123

# Free-model AI desk (optional — weekly handicapper falls back to template)
# OPENROUTER_API_KEY=
# GOOGLE_STUDIO_API_KEY=
# GROK_API_KEY=

LOG_LEVEL=INFO
ENVIRONMENT=dev
